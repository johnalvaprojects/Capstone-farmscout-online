APP_ENV=local

# Database
DB_HOST=localhost
DB_NAME=farmscout_online
DB_USER=root
DB_PASSWORD=

# Email / SMTP
MAIL_FROM_ADDRESS=noreply@farmscout.com
MAIL_FROM_NAME="FarmScout Online - Baloan Public Market"
MAIL_USE_SMTP=false
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=changeme@example.com
MAIL_SMTP_PASSWORD=changeme
MAIL_SMTP_ENCRYPTION=tls
MAIL_TEST_MODE=false
MAIL_TEST_ADDRESS=test@example.com

# URLs
APP_URL=http://localhost/farmscout_online
ASSET_BASE_URL=

# Google Maps
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE
MAP_DEFAULT_LAT=16.8219
MAP_DEFAULT_LNG=120.4042
MAP_DEFAULT_ZOOM=11

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/farmscout_online/auth/google_callback.php
APP_LOGO_URL=http://localhost/farmscout_online/assets/images/farmscoutlogo.png

